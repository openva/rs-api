RewriteEngine On

RewriteRule ^tag-suggest/?$ tag-suggest.php [QSA]

RewriteRule ^bysection/(.*).json$ code-section.php?section=$1 [QSA]
RewriteRule ^section-video/(.*).json$ code-section-video.php?section=$1 [QSA]
RewriteRule ^photosynthesis/([a-z0-9]{5}).json$ photosynthesis.php?hash=$1 [QSA]
RewriteRule ^bills/([0-9]{4}).json$ bills.php?year=$1 [QSA]
RewriteRule ^bill/([0-9]{4})/([A-Za-z0-9]+).json$ bill.php?year=$1&bill=$2 [QSA]
RewriteRule ^legislators.json$ legislators.php [QSA]
RewriteRule ^legislator/([a-z0-9-]+).json$ legislator.php?shortname=$1 [QSA]
RewriteRule ^vote/([0-9]{4})/([a-zA-Z0-9]{4,12}).json$ vote.php?year=$1&lis_id=$2 [QSA]
RewriteRule ^video/([0-9]+).json$ video.php?id=$1 [QSA]
RewriteRule ^videos.json$ videos.php [QSA]

ErrorDocument 404 default

# CACHING
# How long a response may be cached is set here, and only here. (PHP used to set it too, and mod_expires
# added a second max-age, so a response had two, and caches could use either.) "Header set" applies to
# 200 responses only (the "expr" on each line), so that a missing bill or a bad request isn't cached.
ExpiresActive Off

# By default, nothing is cached: lists and records can change at any time.
Header set Cache-Control "max-age=0, public" "expr=%{REQUEST_STATUS} == 200"

# A bill from a past session won't change: 30.5 days.
<If "%{THE_REQUEST} =~ m#^[A-Z]+ /1\.1/bill/[0-9]{4}/#">
    Header set Cache-Control "max-age=2635200, public" "expr=%{REQUEST_STATUS} == 200"
</If>

# A bill from the current session can change, as can portfolios: one hour. (The current session's year
# is taken to be this year.)
<If "%{THE_REQUEST} =~ m#^[A-Z]+ /1\.1/bill/([0-9]{4})/# && %{TIME_YEAR} == $1">
    Header set Cache-Control "max-age=3600, public" "expr=%{REQUEST_STATUS} == 200"
</If>
<If "%{THE_REQUEST} =~ m#^[A-Z]+ /1\.1/photosynthesis/#">
    Header set Cache-Control "max-age=3600, public" "expr=%{REQUEST_STATUS} == 200"
</If>
